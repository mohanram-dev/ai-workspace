# Copy to `.env` in the repository root. Real environment variables take precedence.

# ── Core ──────────────────────────────────────────────────────────────────────
# PostgreSQL connection (docker compose up -d postgres provides this one).
DATABASE_URL=postgres://aiw:aiw@localhost:5432/aiw

# Public URL of the web app. Used for auth callbacks, CSRF origin checks and
# secure cookies (https:// enables Secure cookies + HSTS).
APP_URL=http://localhost:3000

# Secret used to sign sessions. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# ── Model providers ───────────────────────────────────────────────────────────
# Google Gemini API key (https://aistudio.google.com/apikey). Chat is disabled until set.
GEMINI_API_KEY=
# Default model id.
GEMINI_DEFAULT_MODEL=gemini-3.1-flash-lite
# Models offered in the model picker (comma-separated, default is always included).
# Leave empty to offer every text model your API key can use.
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite

# ── OpenAI-compatible provider (spec §13) ────────────────────────────────────
# Any server speaking the OpenAI chat-completions API: vLLM, Ollama, LiteLLM,
# OpenRouter, a self-hosted gateway, or OpenAI itself. Include the version path.
# Unset = the provider is off and only Gemini is offered.
# OPENAI_BASE_URL=http://localhost:8000/v1
# Optional: many local gateways accept requests without a key.
# OPENAI_API_KEY=
# Shown in the UI, so a self-hosted gateway reads as itself.
# OPENAI_PROVIDER_NAME=Local gateway
# OPENAI_DEFAULT_MODEL=
# Models offered in the picker. A gateway may advertise hundreds, so list the
# ones you actually want; the default model is always included.
# OPENAI_MODELS=

# ── OpenRouter (spec §13) ─────────────────────────────────────────────────────
# Hosted access to hundreds of models behind one key (https://openrouter.ai/keys).
# Registered separately from OPENAI_* so a LAN gateway and OpenRouter can both
# be available at once. Unset key = the provider is off.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_DEFAULT_MODEL=qwen/qwen3.7-flash
# Models offered in the picker. OpenRouter advertises 400+, so leaving this
# empty uses the two verified models in packages/runtime/src/env.ts. Any model
# you add must stream, call tools AND honour json_schema on a long prompt —
# some reasoning models return empty content instead, which fails silently.
# OPENROUTER_MODELS=qwen/qwen3.7-flash,openai/gpt-oss-120b
# Optional: the app name OpenRouter attributes usage to on its rankings.
# OPENROUTER_APP_NAME=AI Workspace

# Which provider agents use when they do not name one:
#   gemini | openai-compatible | openrouter
# ROUTER_MODEL below is resolved against THIS provider, so change both together
# or leave ROUTER_MODEL unset to use the provider's own default model.
DEFAULT_PROVIDER=gemini

# ── Agents ──────────────────────────────────────────────────────────────────────
# Model used by the automatic agent router. Unset = the default provider's own
# default model, so it follows DEFAULT_PROVIDER. Set it only to a model that
# provider offers. A reasoning model that spends its whole output budget
# thinking returns empty content here, which silently falls back to the general
# agent — prefer a plain instruct model for routing.
# ROUTER_MODEL=
# Maximum agent tasks one user can run at the same time.
MAX_RUNNING_TASKS_PER_USER=3

# ── Tools ────────────────────────────────────────────────────────────────────────
# Per-user workspaces for file, git and terminal tools (relative to the repository root).
WORKSPACE_ROOT=./data/workspaces
# terminal.run executes programs ON THIS SERVER as the app's OS user, inside the
# user's workspace directory. It is not a container sandbox. Enable only on a
# machine you trust agents to operate. Destructive commands are always blocked.
TERMINAL_ENABLED=false
TERMINAL_ALLOWED_COMMANDS=ls,cat,echo,pwd,grep,find,wc,head,tail,du,df,git,node,npm,python3
TERMINAL_TIMEOUT_SECONDS=60
# Web search backend: gemini (Google Search grounding), searxng (self-hosted) or none.
WEB_SEARCH_PROVIDER=gemini
# Grounding availability depends on model and plan; gemini-2.5-flash-lite works on many free keys.
WEB_SEARCH_MODEL=gemini-2.5-flash-lite
# SEARXNG_URL=http://localhost:8080
# Allow web.fetch to reach private/local network addresses (SSRF protection off). Keep false.
WEB_FETCH_ALLOW_PRIVATE_NETWORK=false

# ── Browser (Phase 6) ─────────────────────────────────────────────────────────
# Headless Chromium for the browser tools. Uses Playwright's Chromium by default:
#   pnpm exec playwright-core install chromium
# or set BROWSER_CHANNEL=chrome|msedge to use an installed browser.
BROWSER_ENABLED=true
BROWSER_CHANNEL=
BROWSER_EXECUTABLE_PATH=
BROWSER_MAX_SESSIONS=3
# Allow the agent browser to open localhost / private network pages.
BROWSER_ALLOW_PRIVATE_NETWORK=false

# ── Projects and files (Phase 9) ──────────────────────────────────────────────
# Project files live under WORKSPACE_ROOT/users/<user>/projects/<project>/ and
# are browsable on the Files page. No extra configuration is needed.

# ── Multi-agent delegation (Phase 11) ─────────────────────────────────────────
# The Manager Agent hands work to other agents with agent.delegate. Each
# sub-task is a real task with its own agent, tools, permissions and cost.
DELEGATION_ENABLED=true
# How many levels deep delegation may go. 1 means a manager delegates once and
# the agents it calls must do the work themselves.
MAX_DELEGATION_DEPTH=1
MAX_DELEGATIONS_PER_TASK=5
MAX_SUBTASK_SECONDS=600

# ── Approvals (Phase 8) ───────────────────────────────────────────────────────
# How long a destructive action waits for your decision before it is refused.
APPROVAL_TIMEOUT_MINUTES=30

# ── Computer use (Phase 7) ─────────────────────────────────────────────────────
# Let the Computer Use Agent control THIS server's real screen, mouse and
# keyboard. Off by default; not a sandbox — only enable on a machine you are
# willing to hand to the agent. Windows uses a built-in PowerShell driver;
# Linux needs xdotool and ImageMagick under an X11 display.
COMPUTER_USE_ENABLED=false
COMPUTER_MAX_WIDTH=1280
# Linux only: the X11 display the driver attaches to.
# DISPLAY=:0

# ── Infrastructure tools (spec §15) ───────────────────────────────────────────
# Docker tools run the real docker CLI on this host: ps, logs, stats, inspect,
# restart, stop and remove. Off by default; stop and remove need approval.
DOCKER_TOOLS_ENABLED=false
DOCKER_TIMEOUT_SECONDS=60
# SSH tools run commands on hosts you name here. The agent picks a host by
# name and can never invent a destination. Authentication uses this server own
# SSH keys or agent; nothing is stored by the app. ssh.run can never run
# unattended, whatever autonomous mode says.
SSH_TOOLS_ENABLED=false
# name=user@host:port, comma separated. Example: web=deploy@10.0.0.5:2222
SSH_HOSTS=
SSH_TIMEOUT_SECONDS=60
# GitHub tools (read-only) work without a token but are rate limited quickly.
# GITHUB_TOKEN=
# GITHUB_API_URL=https://api.github.com

# ── MCP ───────────────────────────────────────────────────────────────────────
# stdio MCP servers start a command on this host (not sandboxed). Only admins can
# add them, and only when this is true.
MCP_STDIO_ENABLED=false
# Allow http MCP servers on localhost / private networks (e.g. a local Docker MCP server).
MCP_ALLOW_PRIVATE_NETWORK=false
# MCP header and environment secrets are encrypted with a key derived from
# BETTER_AUTH_SECRET; changing that secret means re-entering them.

# ── Security ──────────────────────────────────────────────────────────────────
# The first account always becomes admin. Set to true to allow additional sign-ups.
ALLOW_REGISTRATION=false
# Per-user chat messages allowed per minute.
CHAT_RATE_LIMIT_PER_MINUTE=20

# ── Production (Phase 12) ─────────────────────────────────────────────────────
# Without REDIS_URL the web server runs tasks itself: one process, no worker.
# Set it to hand execution to the worker tier (apps/worker), which is what the
# production compose file does.
# REDIS_URL=redis://localhost:6379
# Tasks one worker process runs at once.
WORKER_CONCURRENCY=3
# Which process fires schedules. Exactly one should: the worker in queue mode,
# otherwise the web server. Set to false on extra replicas.
RUN_SCHEDULER=true

# ── Tests ─────────────────────────────────────────────────────────────────────
# Integration tests reset this database. Its name must end in `_test`.
# TEST_DATABASE_URL=postgres://aiw:aiw@localhost:5432/aiw_test
